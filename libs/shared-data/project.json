{
  "name": "shared-data",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared-data/src",
  "prefix": "data",
  "projectType": "library",
  "tags": ["scope:shared", "type:data"],
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "libs/shared-data/ng-package.json",
        "tsConfig": "libs/shared-data/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/shared-data/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "codegen-api": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash libs/shared-data/scripts/generate-api-clients.sh",
        "cwd": "{workspaceRoot}"
      },
      "inputs": [
        "{workspaceRoot}/libs/shared-data/openapi/selecao.openapi.json",
        "{workspaceRoot}/libs/shared-data/openapi/ingresso.openapi.json",
        "{workspaceRoot}/libs/shared-data/openapi/organizacao.openapi.json",
        "{workspaceRoot}/libs/shared-data/openapi/configuracao.openapi.json",
        "{workspaceRoot}/libs/shared-data/openapi/geo.openapi.json",
        "{workspaceRoot}/libs/shared-data/openapi/publicacoes.openapi.json",
        "{workspaceRoot}/libs/shared-data/openapi/portal.openapi.json",
        "{workspaceRoot}/libs/shared-data/openapi/autorizacao.openapi.json",
        "{projectRoot}/scripts/generate-api-clients.sh"
      ],
      "outputs": [
        "{projectRoot}/src/lib/api/selecao/schema.ts",
        "{projectRoot}/src/lib/api/ingresso/schema.ts",
        "{projectRoot}/src/lib/api/organizacao/schema.ts",
        "{projectRoot}/src/lib/api/configuracao/schema.ts",
        "{projectRoot}/src/lib/api/geo/schema.ts",
        "{projectRoot}/src/lib/api/publicacoes/schema.ts",
        "{projectRoot}/src/lib/api/portal/schema.ts",
        "{projectRoot}/src/lib/api/autorizacao/schema.ts"
      ]
    },
    "codegen-api-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash libs/shared-data/scripts/verify-codegen.sh",
        "cwd": "{workspaceRoot}"
      }
    },
    "contract-copies-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash libs/shared-data/scripts/verify-contract-copies.sh",
        "cwd": "{workspaceRoot}"
      },
      "cache": false
    },
    "test": {
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/apps/*/project.json",
        "{workspaceRoot}/libs/*/project.json",
        "{workspaceRoot}/tools/**/project.json",
        { "externalDependencies": ["vitest"] },
        { "env": "CI" },
        { "dependentTasksOutputFiles": "**/*.js", "transitive": true }
      ]
    },
    "typecheck-spec": {}
  }
}
