{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@uniplus/eslint",
  "sourceRoot": "tools/eslint",
  "projectType": "library",
  "tags": [],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/apps/*/eslint.config.mjs",
        "{workspaceRoot}/libs/*/eslint.config.mjs",
        "{workspaceRoot}/apps/*/project.json",
        "{workspaceRoot}/libs/*/project.json",
        "{workspaceRoot}/tsconfig.base.json",
        {
          "externalDependencies": ["vitest"]
        },
        {
          "env": "CI"
        },
        {
          "dependentTasksOutputFiles": "**/*.js",
          "transitive": true
        },
        "{workspaceRoot}/libs/*/*/ng-package.json",
        "{workspaceRoot}/libs/*/*/project.json",
        "{workspaceRoot}/libs/*/package.json"
      ]
    }
  }
}
