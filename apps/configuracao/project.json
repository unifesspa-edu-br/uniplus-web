{
  "name": "configuracao",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "cfg",
  "sourceRoot": "apps/configuracao/src",
  "tags": ["scope:configuracao", "type:app"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/configuracao",
        "browser": "apps/configuracao/src/main.ts",
        "tsConfig": "apps/configuracao/tsconfig.app.json",
        "baseHref": "./",
        "inlineStyleLanguage": "css",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/configuracao/public"
          },
          {
            "glob": "**/*",
            "input": "libs/shared-ui/src/assets",
            "output": "assets/shared-ui"
          }
        ],
        "styles": ["apps/configuracao/src/styles.css"],
        "polyfills": ["zone.js"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "optimization": {
            "scripts": true,
            "fonts": true,
            "styles": {
              "minify": true,
              "inlineCritical": false
            }
          }
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "options": {
        "port": 4203
      },
      "configurations": {
        "production": {
          "buildTarget": "configuracao:build:production"
        },
        "development": {
          "buildTarget": "configuracao:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "configuracao:build",
        "port": 4203,
        "staticFilePath": "dist/apps/configuracao/browser",
        "spa": true
      }
    }
  }
}
